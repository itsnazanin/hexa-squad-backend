// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  name             String?
  email            String?           @unique
  phone            String?           @unique
  password         String
  nationalCode     String?
  birthDate        DateTime?
  avatar           String?
  role             Role              @default(STUDENT)
  teacher          Teacher?
  orders           Order[]
  favorites        Favorite[]
  reviews          Review[]
  comments         Comment[]
  purchasedCourses PurchasedCourse[]
  courseReaction   CourseReaction[]
  blogReactions    BlogReaction[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  commentLikes     CommentLike[]
}

enum Role {
  STUDENT
  TEACHER
}

enum VerifectionPurpose {
  LOGIN
  REGISTER
}

model VerifectionCode {
  id          Int   @id   @default(autoincrement())
  identifier  String
  purpose     VerifectionPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int   @default(0)
  consumedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([identifier, purpose])
  @@index([expiresAt])  
}

model Course {
  id               Int                 @id @default(autoincrement())
  studentCount     Int                 @default(0)
  status           CourseStatus
  startDate        DateTime?
  endDate          DateTime?
  uploadDate       DateTime?
  thumbnail        String?
  courseTime       Int
  price            Int
  teacherId        Int
  teacher          Teacher             @relation(fields: [teacherId], references: [id])
  categoryId       Int
  category         Category            @relation(fields: [categoryId], references: [id])
  translations     CourseTranslation[]
  comments         Comment[]
  favorites        Favorite[]
  purchasedCourses PurchasedCourse[]
  orderItem        OrderItem[]
  sections         Section[]
  reviews          Review[]
  reactions        CourseReaction[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([teacherId])
  @@index([categoryId])
}

model CourseTranslation {
  id               Int      @id @default(autoincrement())
  courseId         Int
  language         Language
  title            String
  shortDescription String
  description      String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, language])
  @@index([courseId])
}

enum Language {
  FA
  EN
}

model CourseReaction {
  id        Int          @id @default(autoincrement())
  userId    Int
  courseId  Int
  type      ReactionType
  user      User         @relation(fields: [userId], references: [id])
  course    Course       @relation(fields: [courseId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([userId, courseId])
}

enum CourseStatus {
  PENDING
  COMPLETED
}

model Teacher {
  id           Int                  @id @default(autoincrement())
  userId       Int                  @unique
  user         User                 @relation(fields: [userId], references: [id])
  avatar       String?
  courses      Course[]
  translations TeacherTranslation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model TeacherTranslation {
  id        Int      @id @default(autoincrement())
  name      String
  bio       String
  language  Language
  teacherId Int
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, language])
  @@index([teacherId])
}

model Section {
  id           Int                  @id @default(autoincrement())
  order        Int
  courseId     Int
  translations SectionTranslation[]
  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([courseId])
}

model SectionTranslation {
  id        Int      @id @default(autoincrement())
  sectionId Int
  language  Language
  title     String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, language])
  @@index([sectionId])
}

model Lesson {
  id           Int                 @id @default(autoincrement())
  duration     Int
  order        Int
  sectionId    Int
  translations LessonTranslation[]
  section      Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  files        LessonFile[]

  @@index([sectionId])
}

model LessonFile {
  id        Int      @id @default(autoincrement())
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([lessonId])
}

model LessonTranslation {
  id       Int      @id @default(autoincrement())
  lessonId Int
  title    String
  language Language
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, language])
  @@index([lessonId])
}

model Order {
  id         Int         @id @default(autoincrement())
  totalPrice Int
  status     OrderStatus
  userId     Int?
  user       User?       @relation(fields: [userId], references: [id])
  guestName  String?
  guestPhone String?
  guestEmail String?
  guestCheckoutTokenHash String?
  purchasedCourses PurchasedCourse[]
  items      OrderItem[]
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([guestPhone])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  courseId  Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id])
  price     Int
  createdAt DateTime @default(now())

  @@unique([orderId, courseId])
  @@index([orderId])
  @@index([courseId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int?
  blogId    Int?
  user      User     @relation(fields: [userId], references: [id])
  course    Course?  @relation(fields: [courseId], references: [id])
  blog      Blog?    @relation(fields: [blogId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@unique([userId, blogId])
  @@index([userId])
  @@index([courseId])
  @@index([blogId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  userId    Int
  courseId  Int
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model Comment {
  id       Int           @id @default(autoincrement())
  content  String
  userId   Int
  courseId Int?
  blogId   Int?
  parentId Int?
  user     User          @relation(fields: [userId], references: [id])
  course   Course?       @relation(fields: [courseId], references: [id])
  parent   Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  blog     Blog?         @relation(fields: [blogId], references: [id])
  replies  Comment[]     @relation("CommentReplies")
  likes    CommentLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([blogId])
  @@index([parentId])
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  commentId Int
  user      User     @relation(fields: [userId], references: [id])
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model PurchasedCourse {
  id        Int      @id @default(autoincrement())
  userId    Int?
  courseId  Int
  user      User?    @relation(fields: [userId], references: [id])
  orderId   Int?
  order     Order?   @relation(fields: [orderId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@unique([orderId, courseId])
  @@index([userId])
  @@index([orderId])
  @@index([courseId])
}

model Blog {
  id           Int               @id @default(autoincrement())
  coverImage   String
  blogImage    String?
  viewCount    Int               @default(0)
  comments     Comment[]
  favorites    Favorite[]
  reactions    BlogReaction[]
  translations BlogTranslation[]
  author       String
  authorImage  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model BlogTranslation {
  id               Int      @id @default(autoincrement())
  title            String
  shortDescription String
  content          String  @db.Text
  blogId           Int
  language         Language
  blog             Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, language])
  @@index([blogId])
}

model BlogReaction {
  id        Int          @id @default(autoincrement())
  userId    Int
  blogId    Int
  type      ReactionType
  user      User         @relation(fields: [userId], references: [id])
  blog      Blog         @relation(fields: [blogId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([userId, blogId])
  @@index([blogId])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model Category {
  id           Int                   @id @default(autoincrement())
  courses      Course[]
  translations CategoryTranslation[]
  createdAt    DateTime              @default(now())
}

model CategoryTranslation {
  id         Int      @id @default(autoincrement())
  categoryId Int
  language   Language
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@index([categoryId])
}
